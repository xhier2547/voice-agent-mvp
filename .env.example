# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Credentials (from Twilio Console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Call Transfer Configuration (e.g. +66812345678 in E.164 format)
TRANSFER_NUMBER=+66812345678

# Gemini Model Configuration (default: models/gemini-2.5-flash-native-audio-latest)
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-latest

# Gemini Voice Selection (Aoede, Puck, Charon, Kore, Fenrir)
GEMINI_VOICE=Aoede

# Server Config
PORT=8000
